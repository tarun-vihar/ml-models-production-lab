# Optional for GRAPH_MODE=aws. Use the Neptune cluster endpoint reachable from the app.
NEPTUNE_ENDPOINT=https://your-neptune-cluster.cluster-xxxxxxxx.us-east-1.neptune.amazonaws.com:8182
AWS_REGION=us-east-1
# Optional local AWS config profile. In ECS, use the task role and leave this unset.
AWS_PROFILE=
NEPTUNE_AUTH_MODE=iam
