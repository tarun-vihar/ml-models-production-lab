KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MSK_AUTH_MODE=none
AWS_REGION=
AWS_PROFILE=
KAFKA_INPUT_TOPIC=enriched-transactions
KAFKA_OUTPUT_TOPIC=scored-transactions
KAFKA_DLQ_TOPIC=scoring-dead-letter-transactions
KAFKA_CONSUMER_GROUP=fraud-scoring-v1
MODEL_MODE=xgboost
MODEL_DIR=/models
MODEL_VERSION=fraud-xgb-2026-01
MODEL_FEATURE_MANIFEST=/models/feature-manifest.json
FRAUD_SCORING_MODEL_ARTIFACTS_DIR=./fraud-scoring/artifacts
SCORING_THRESHOLD_MEDIUM=0.30
SCORING_THRESHOLD_HIGH=0.70
MAX_PROCESSING_ATTEMPTS=3
METRICS_PORT=8000
